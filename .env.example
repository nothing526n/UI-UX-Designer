# =====================================================================
# APEX AI UI/UX DESIGNER & DESIGN-TO-CODE PLATFORM - ENV TEMPLATE
# =====================================================================

# 1. Primary Relational Store (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://platform:platform_dev_password@localhost:5432/platform_db
REQUIRE_LIVE_DB=false

# 2. Ephemeral Event Bus & Distributed Job Queue (Redis 7)
REDIS_URL=redis://localhost:6379

# 3. Security, Identity & Session Tokens
JWT_SECRET=platform_foundation_secret_key_prod_v1_change_before_launch
NODE_ENV=production
PORT=4000

# 4. AI Model Gateway & Provider Routing Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Cloud Object Storage (S3 / GCS Asset Presigning)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=apex-studio-artifacts

# 6. Web Studio Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
