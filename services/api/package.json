{
  "name": "@platform/api",
  "version": "1.0.0",
  "description": "REST and Realtime API Gateway for AI UI/UX Designer Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "tsx src/db/seed.ts",
    "test": "node test_phase1.mjs && node test_phase2.mjs && node test_database_queue_auth.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@platform/contracts": "*",
    "@platform/design-system": "*",
    "@platform/agent-runtime": "*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "archiver": "^7.0.1",
    "zod": "^3.23.8",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.11",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
